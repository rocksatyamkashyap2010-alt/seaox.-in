
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SEAOX - Menu</title>
    <link rel="icon" type="image/jpeg" href="IMG_20261019_105230.jpg">
    <style>
        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Top Header (Logo and Menu) */
        .header {
            width: 100%;
            max-width: 450px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .logo-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-img {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            object-fit: cover;
        }
        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: #111;
        }
        .menu-icon {
            font-size: 30px;
            color: #333;
            cursor: pointer;
        }

        /* Yellow App Box */
        .app-box {
            width: 100%;
            max-width: 450px;
            height: 350px;
            background-color: #FFD700; /* Yellow */
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-decoration: none;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }
        .app-box:active {
            transform: scale(0.98);
        }
        .app-icon {
            font-size: 80px;
            margin-bottom: 10px;
        }
        .app-text {
            font-size: 50px;
            font-weight: 900;
            color: #111;
            letter-spacing: 2px;
        }

        /* Green Contact Box */
        .contact-box {
            width: 100%;
            max-width: 450px;
            background-color: #00A859; /* Green */
            border-radius: 20px;
            padding: 20px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }
        .contact-box:active {
            transform: scale(0.98);
        }
        .contact-icon {
            font-size: 50px;
            color: white;
        }
        .contact-text {
            color: white;
            font-size: 18px;
            font-weight: bold;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div class="logo-container">
            <img src="IMG_20261019_105230.jpg" alt="Seaox Logo" class="logo-img">
            <span class="logo-text">Seaox</span>
        </div>
        <div class="menu-icon">☰</div>
    </div>

    <!-- APP Button (Yeh Store par le jayega) -->
    <a href="store.html" class="app-box">
        <div class="app-icon">📱</div>
        <div class="app-text">APP</div>
    </a>

    <!-- Let's Talk Button (Yeh Email kholega) -->
    <!-- seox129@gmail.com
    <a href="mailto:hello@seaox.in?subject=Website/App Development Inquiry" class="contact-box">
        <div class="contact-icon">💬</div>
        <div class="contact-text">
            Want to build a website, app, or software?<br>
            Let's talk!
        </div>
    </a>

</body>
</html>
